---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import DigitalToday from "../components/DigitalToday.astro";
import TeamConsulting from "../components/TeamConsulting.astro";
import Testimonials from "../components/Testimonials.astro";
import ClientStories from "../components/ClientStories.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <!--
    Header sticky fuera de este bloque para que se quede pegado en
    toda la página (si vive acá, el alto 100svh lo despega al salir).
    El hero sigue midiendo "lo que queda" de la primera pantalla.
    En mobile/tablet no forzamos 100svh: el hero se apila y necesita
    más de un viewport.
  -->
  <Header />
  <div class="flex flex-col lg:h-[calc(100svh-var(--header-height))]">
    <Hero />
  </div>
  <main>
    <DigitalToday />
    <TeamConsulting />
    <Testimonials />
    <ClientStories />
    <ContactForm />
  </main>
  <Footer />
</BaseLayout>
