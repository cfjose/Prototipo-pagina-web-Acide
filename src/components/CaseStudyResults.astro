---
import { Image } from "astro:assets";
import phoneImage from "../assets/img/results/card-phone.png";
import retailImage from "../assets/img/results/card-retail.png";
import techgroupImage from "../assets/img/results/image-techgroup.png";
import bankingImage from "../assets/img/servicios/img-1-banking-app.png";

/*
  4 resultados del caso — mismo patrón que ServicesGallery.astro (Home:
  "Sitios Web / Aplicaciones Web / ..."): sección fija (pin) en el
  viewport, dos columnas (texto a la izquierda, imagen a la derecha),
  el scroll avanza entre los 4 resultados en el mismo lugar, con una
  barra de progreso por resultado debajo. Ver case-study-results.js.

  Atributos con prefijo "case-" (data-case-results-*) A PROPÓSITO —
  mismo motivo que antes: ServicesGallery usa data-gallery-* e
  initServicesGallery() corre en TODAS las páginas vía main.js, así que
  si usáramos esos mismos nombres acá los dos scripts agarrarían estos
  elementos a la vez (mismo bug de pin duplicado que ya pasamos).

  A diferencia de ServicesGallery: acá no hay eyebrow numérico ni botón
  por ítem (no hay a dónde linkear cada resultado individual), y la
  transición del texto es distinta — ver el comentario en
  case-study-results.js sobre por qué el texto NO usa el mismo
  cross-fade con blur que Servicios.

  En mobile no hay pin — lista normal con imagen, mismo criterio que
  ServicesGallery.
*/
const results = [
  {
    title: "+60% en ventas online",
    description: "En los primeros 6 meses, las ventas por el canal digital crecieron 60% frente al mismo período del año anterior.",
    image: retailImage,
    alt: "Gráfico de crecimiento de ventas",
  },
  {
    title: "−80% en errores de pedido",
    description: "El catálogo sincronizado con inventario en tiempo real eliminó casi por completo los pedidos mal registrados.",
    image: techgroupImage,
    alt: "Dashboard de analítica mostrando métricas de pedidos",
  },
  {
    title: "−70% en tiempo de gestión",
    description: "El equipo comercial dejó de corregir errores a mano y recuperó horas cada semana para dedicarse a vender.",
    image: bankingImage,
    alt: "App mostrando el panel de gestión de pedidos",
  },
  {
    title: "100% de pagos autónomos",
    description: "La pasarela integrada le dio al equipo control total sobre los cobros, sin depender de terceros para confirmar cada venta.",
    image: phoneImage,
    alt: "Celular mostrando la confirmación de un pago",
  },
];
---

<section class="wrapper section-y">
  <!-- Desktop: stage fijo, los 4 resultados se cruzan en el mismo lugar -->
  <div class="relative hidden lg:block" data-case-results-pin>
    <div data-case-results-pin-content>
      <div class="grid w-full grid-cols-2 items-center gap-[92px]">
        <div class="grid" data-case-results-text-stack>
          {
            results.map((result, i) => (
              <div class="col-start-1 row-start-1 flex flex-col justify-center gap-4" data-case-results-text-item data-index={i}>
                <p class="font-display text-[54px] leading-[1.05] tracking-[-1.62px] text-navy">{result.title}</p>
                <p class="max-w-[460px] font-body text-[22px] leading-[1.5] tracking-[-0.5px] text-ink">{result.description}</p>
              </div>
            ))
          }
        </div>

        <div class="relative mx-auto aspect-[755/1024] h-[75vh] w-auto max-w-full overflow-hidden" data-case-results-media-stack>
          {
            results.map((result) => (
              <div class="absolute inset-0" data-case-results-media-item>
                <Image src={result.image} alt={result.alt} width={755} height={1024} class="h-full w-full object-cover" />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Barra de progreso, mismo criterio de "si no entra, se esconde" que ServicesGallery. -->
    <div class="mt-[80px] flex items-center gap-3" data-case-results-bars>
      {
        results.map(() => (
          <div class="h-[3px] flex-1 overflow-hidden bg-black/10">
            <div class="h-full w-0 bg-navy" data-case-results-bar-fill />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Mobile/tablet: lista normal, sin pin -->
  <div class="flex flex-col gap-16 lg:hidden">
    <h2
      data-text-reveal
      data-reveal
      class="text-center font-display text-[32px] leading-[1.1] tracking-[-1px] text-secondary sm:text-[44px] sm:tracking-[-1.4px]"
    >
      El resultado <span class="text-navy">que logramos</span>
    </h2>
    {
      results.map((result) => (
        <div class="flex flex-col gap-6">
          <div class="relative aspect-[1184/664] w-full overflow-hidden">
            <Image src={result.image} alt={result.alt} width={1184} height={664} class="h-full w-full object-cover" />
          </div>
          <p class="font-display text-[38px] leading-[1.05] tracking-[-1.2px] text-navy sm:text-[44px]">{result.title}</p>
          <p class="font-body text-[18px] leading-[1.5] tracking-[-0.5px] text-ink">{result.description}</p>
        </div>
      ))
    }
  </div>
</section>
