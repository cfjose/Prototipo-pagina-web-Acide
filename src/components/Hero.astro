---
import { Image } from "astro:assets";
import dashboardMonitors from "../assets/img/hero/dashboard-monitors.png";
import wireframeNotebook from "../assets/img/hero/wireframe-notebook.png";
import codeBuildDesk from "../assets/img/hero/code-build-desk.png";
import whiteboardProcess from "../assets/img/hero/whiteboard-process.png";
import codeEditorLaptop from "../assets/img/hero/code-editor-laptop.png";
import reportCalculator from "../assets/img/hero/report-calculator.png";

// Columna izquierda flota hacia arriba, derecha hacia abajo (ver hero-gallery.js).
// Solo 6 imágenes en total (3 por columna), resincronizadas 1:1 con el
// orden real del Figma (node 164:824, Image Gallery) — el Figma
// actualizado ya no tiene el borde redondeado grande por esquina
// alterna, es un radio chico (8px) parejo en las 4 esquinas.
const columnLeft = [
  { src: dashboardMonitors, alt: "Dos monitores mostrando un dashboard y un diagrama de flujo" },
  { src: wireframeNotebook, alt: "Cuaderno con bocetos de wireframes" },
  { src: codeBuildDesk, alt: "Escritorio con lámpara y monitor mostrando un build exitoso en el editor de código" },
];
const columnRight = [
  { src: whiteboardProcess, alt: "Pizarra con el proceso Idea, Desarrollo, Lanzamiento y Crecimiento" },
  { src: codeEditorLaptop, alt: "Laptop con un editor de código abierto" },
  { src: reportCalculator, alt: "Reporte con gráficos de crecimiento junto a una calculadora" },
];

// Frases que rotan en el acento del H1 ("Tu próxima gran idea merece el
// ___") — tipeo/borrado en loop, ver hero-rotating-word.js. Todas
// concuerdan en género con "el" (no "la") para que la oración siga
// leyéndose bien sin importar cuál esté tipeada.
const rotatingWords = ["mejor trabajo", "mejor equipo", "socio digital ideal", "software que necesitas", "aliado tecnológico correcto"];
const longestWord = rotatingWords.reduce((a, b) => (a.length >= b.length ? a : b));
---


<!--
  El header es sticky y vive arriba de este bloque (index.astro).
  Este section usa flex-1 para ocupar lo que queda de la primera
  pantalla en lg+, sin restarle un alto fijo en px.
-->
<section class="wrapper flex flex-col justify-center gap-8 py-8 lg:min-h-0 lg:flex-1 lg:flex-row lg:items-stretch lg:gap-[80px] lg:py-10">
  <div class="flex flex-col items-start justify-center gap-10 lg:w-[610px] lg:shrink-0 lg:gap-16">
    <div class="relative" data-hero-title>
      <h1
        class="max-w-[560px] font-display text-[38px] leading-[1.12] tracking-[-1.2px] sm:text-[52px] sm:tracking-[-2px] lg:w-[610px] lg:max-w-none lg:text-[78px] lg:leading-[1.05] lg:tracking-[-4px]"
      >
        <span class="text-slate">Tu próxima gran idea merece el </span>
        <span class="relative inline-grid items-start justify-items-start">
          <span class="invisible col-start-1 row-start-1 font-bold" aria-hidden="true">{longestWord}</span>
          <span
            class="relative col-start-1 row-start-1 self-start font-bold text-navy"
            data-hero-rotating-word
            data-words={JSON.stringify(rotatingWords)}
          >
            <span data-hero-rotating-text>{rotatingWords[0]}</span><span
              class="text-type-caret"
              data-hero-caret
              style="background-color:var(--color-navy)"></span>
            <svg
              data-hero-underline
              class="pointer-events-none absolute top-full left-0 mt-1 h-[0.44em] w-full overflow-visible"
              viewBox="0 0 610 33.9558"
              preserveAspectRatio="none"
              overflow="visible"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                data-hero-underline-path
                fill="#F43159"
                d="M609.567 6.20395C574.48 6.20395 539.392 6.0599 504.33 6.25197C482.89 6.38001 461.451 6.89214 440.037 7.46833C420.354 7.9965 400.672 8.62071 381.014 9.56501C349.135 11.1015 317.205 12.494 285.453 14.7027C200.408 20.5927 115.464 26.8827 30.47 32.9807C24.3081 33.4288 17.8406 34.4532 12.0351 33.6689C7.681 33.0768 2.35928 30.4839 0.704207 27.9551C-1.86752 24.0178 2.97053 22.0971 9.28526 21.729C45.1876 19.5843 81.0899 17.3276 117.018 15.2149C184.01 11.2616 250.977 7.18023 318.02 3.56305C347.658 1.96253 377.45 0.986234 407.19 0.490071C417.248 0.330019 427.305 0.201997 437.389 0.00993384C446.046 -0.150119 455.034 1.69047 463.335 0.746161C475.71 -0.6623 487.703 2.47472 499.416 1.19431C515.152 -0.518255 530.251 1.99455 545.656 1.97855C561.85 1.94654 578.07 1.97857 594.264 2.29867C599.535 2.41071 604.755 3.49907 610 4.15528C609.873 4.8275 609.745 5.51573 609.618 6.20395H609.567Z"
              />
            </svg>
          </span>
        </span>
      </h1>
    </div>

    <div class="flex flex-col items-start gap-4 sm:flex-row sm:gap-4 lg:gap-5">
      <a href="#contacto" class="btn btn--primary">Descubre cómo lo hicimos</a>
      <a href="#contacto" class="btn btn--secondary">
        Contacte con nosotros
        <svg width="20" height="20" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d="M222.37,158.46l-47.11-21.11-.12-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.76a16,16,0,0,0,1.32-15.06l0-.13L97.54,33.63a16,16,0,0,0-16.62-9.52A56.26,56.26,0,0,0,32,80c0,80.47,65.53,146,146,146a56.26,56.26,0,0,0,55.89-48.92A16,16,0,0,0,222.37,158.46Z" />
        </svg>
      </a>
    </div>
  </div>

  <div class="relative grid w-full grid-cols-2 gap-3 overflow-hidden lg:h-full lg:min-h-0 lg:flex-1" data-hero-gallery>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 z-10 h-[13.41%] bg-gradient-to-b from-white to-white/0"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[13.41%] bg-gradient-to-t from-white to-white/0"
    >
    </div>
    <div class="aspect-[374/690] overflow-hidden lg:aspect-auto lg:h-full lg:min-h-0" data-hero-viewport>
      <div class="flex flex-col gap-3 lg:h-full lg:min-h-0" data-hero-track data-hero-col="up">
        {
          [false, true].map((duplicate) => (
            <div class="flex flex-col gap-3 lg:h-full lg:min-h-0 lg:shrink-0" aria-hidden={duplicate ? "true" : undefined}>
              {columnLeft.map((img) => (
                <div class="aspect-[374/300] overflow-hidden will-change-transform lg:aspect-auto lg:min-h-0 lg:flex-1" data-hero-image>
                  <Image
                    src={img.src}
                    alt={duplicate ? "" : img.alt}
                    width={374}
                    height={300}
                    class="h-full w-full object-cover"
                  />
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="aspect-[374/690] overflow-hidden lg:aspect-auto lg:h-full lg:min-h-0" data-hero-viewport>
      <div class="flex flex-col gap-3 lg:h-full lg:min-h-0" data-hero-track data-hero-col="down">
        {
          [false, true].map((duplicate) => (
            <div class="flex flex-col gap-3 lg:h-full lg:min-h-0 lg:shrink-0" aria-hidden={duplicate ? "true" : undefined}>
              {columnRight.map((img) => (
                <div class="aspect-[374/300] overflow-hidden will-change-transform lg:aspect-auto lg:min-h-0 lg:flex-1" data-hero-image>
                  <Image
                    src={img.src}
                    alt={duplicate ? "" : img.alt}
                    width={374}
                    height={300}
                    class="h-full w-full object-cover"
                  />
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
