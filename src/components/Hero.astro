---
import { Image } from "astro:assets";
import underline from "../assets/img/hero/underline.svg";
import phoneApp from "../assets/img/hero/phone-app.png";
import deskPalette from "../assets/img/hero/desk-palette.png";
import digitalWave from "../assets/img/hero/digital-wave.png";
import handshake from "../assets/img/hero/handshake.png";
import deskWriting from "../assets/img/hero/desk-writing.png";
import serverRoom from "../assets/img/hero/server-room.png";

// Columna izquierda flota hacia arriba, derecha hacia abajo (ver hero-gallery.js).
// Solo 6 imágenes en total (3 por columna) — el Figma actualizado ya no
// tiene el borde redondeado grande por esquina alterna, es un radio chico
// (8px) parejo en las 4 esquinas.
const columnLeft = [
  { src: deskPalette, alt: "Laptop con paleta de colores y notas de diseño" },
  { src: handshake, alt: "Dos personas de negocios dándose la mano" },
  { src: serverRoom, alt: "Pasillo de un centro de datos" },
];
const columnRight = [
  { src: phoneApp, alt: "Celular en un soporte mostrando un dashboard de métricas" },
  { src: digitalWave, alt: "Visualización de datos digitales en movimiento" },
  { src: deskWriting, alt: "Persona escribiendo un boceto en un escritorio" },
];
---


<!--
  El Header no es fijo — así que en vez de restarle un alto fijo en px
  (frágil: el header mide distinto según el ancho de pantalla), este
  section vive en un flex-col junto al Header (ver index.astro) con
  flex-1: toma automáticamente "lo que sobra" de la pantalla después del
  header, sin números mágicos, a cualquier ancho.
-->
<section class="wrapper flex flex-col justify-center gap-8 py-8 lg:min-h-0 lg:flex-1 lg:flex-row lg:items-stretch lg:gap-[80px] lg:py-10">
  <div class="flex flex-col items-start justify-center gap-10 lg:w-[610px] lg:shrink-0 lg:gap-16">
    <div class="relative" data-hero-title>
      <h1
        class="max-w-[560px] font-display text-[38px] leading-[1.12] tracking-[-1.2px] sm:text-[52px] sm:tracking-[-2px] lg:w-[610px] lg:max-w-none lg:text-[78px] lg:leading-[1.05] lg:tracking-[-4px]"
      >
        <span class="text-slate">Tu próxima gran idea merece el </span><span class="font-bold text-navy">mejor trabajo</span>
      </h1>
      <img
        data-hero-underline
        src={underline.src}
        width={underline.width}
        height={underline.height}
        alt=""
        aria-hidden="true"
        class="mt-5 h-auto w-[220px] sm:w-[320px] lg:absolute lg:-bottom-6 lg:left-0 lg:mt-0 lg:w-[520px]"
      />
    </div>

    <div class="flex flex-col items-start gap-8 lg:gap-10">
      <p
        data-hero-description
        class="max-w-[560px] font-body text-[16px] leading-[1.5] tracking-[-0.3px] text-ink sm:text-[18px] sm:tracking-[-0.5px] lg:max-w-[486px]"
      >
        Detrás de cada empresa que crece hay una decisión valiente: apostar por la tecnología correcta. Nosotros la
        construimos contigo — desde la primera línea de código hasta el producto que tus usuarios no van a querer
        soltar.
      </p>
      <a href="#contacto" class="btn btn--primary">Descubre cómo lo hicimos</a>
    </div>
  </div>

  <div class="relative grid w-full grid-cols-2 gap-3 overflow-hidden lg:h-full lg:min-h-0 lg:flex-1" data-hero-gallery>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 z-10 h-[13.41%] bg-gradient-to-b from-white to-white/0"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[13.41%] bg-gradient-to-t from-white to-white/0"
    >
    </div>
    <div class="aspect-[374/690] overflow-hidden lg:aspect-auto lg:h-full lg:min-h-0" data-hero-viewport>
      <div class="flex flex-col gap-3 lg:h-full lg:min-h-0" data-hero-track data-hero-col="up">
        {
          [false, true].map((duplicate) => (
            <div class="flex flex-col gap-3 lg:h-full lg:min-h-0 lg:shrink-0" aria-hidden={duplicate ? "true" : undefined}>
              {columnLeft.map((img) => (
                <div class="aspect-[374/300] overflow-hidden will-change-transform lg:aspect-auto lg:min-h-0 lg:flex-1" data-hero-image>
                  <Image
                    src={img.src}
                    alt={duplicate ? "" : img.alt}
                    width={374}
                    height={300}
                    class="h-full w-full rounded-[8px] object-cover"
                  />
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="aspect-[374/690] overflow-hidden lg:aspect-auto lg:h-full lg:min-h-0" data-hero-viewport>
      <div class="flex flex-col gap-3 lg:h-full lg:min-h-0" data-hero-track data-hero-col="down">
        {
          [false, true].map((duplicate) => (
            <div class="flex flex-col gap-3 lg:h-full lg:min-h-0 lg:shrink-0" aria-hidden={duplicate ? "true" : undefined}>
              {columnRight.map((img) => (
                <div class="aspect-[374/300] overflow-hidden will-change-transform lg:aspect-auto lg:min-h-0 lg:flex-1" data-hero-image>
                  <Image
                    src={img.src}
                    alt={duplicate ? "" : img.alt}
                    width={374}
                    height={300}
                    class="h-full w-full rounded-[8px] object-cover"
                  />
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
