---
import { Image } from "astro:assets";
import strategyImage from "../assets/img/team-consulting/capacitaciones.png";
import advisoryImage from "../assets/img/team-consulting/asesoria.png";
import consultingImage from "../assets/img/team-consulting/consultoria.png";

/*
  Todo el copy de sub-servicios (bullets) y el botón acá es modelo — en
  Figma esta sección todavía no tiene la estructura de 3 sub-items +
  botón que sí tiene "Sitios Web" en la sección de Desarrollo. Replicamos
  el mismo patrón visual para mantener consistencia entre ambas secciones.
  Reemplazar por el copy real del cliente cuando esté.

  Los links "Ver mas información del servicio" apuntan a /servicios/<slug>
  — esas páginas todavía no existen, van a dar 404 hasta que se armen.
*/
const items = [
  {
    title: "Capacitaciones",
    slug: "capacitaciones",
    description:
      "Acompañamos a equipos que quieren dejar de improvisar y empezar a tomar decisiones con datos, método y visión de largo plazo.",
    bullets: ["Talleres a medida", "Certificación de equipos", "Seguimiento post-taller"],
    image: strategyImage,
    alt: "Capacitación de equipo en Acide",
  },
  {
    title: "Asesoría",
    slug: "asesoria",
    description:
      "Te acompañamos en las decisiones difíciles — desde elegir la arquitectura correcta hasta priorizar qué construir primero, con la experiencia de haberlo hecho antes en decenas de proyectos.",
    bullets: ["Diagnóstico inicial", "Plan de acción", "Acompañamiento continuo"],
    image: advisoryImage,
    alt: "Sesión de asesoría con un cliente",
  },
  {
    title: "Consultoría",
    slug: "consultoria",
    description:
      "Diagnosticamos el estado real de tu operación digital y armamos un plan concreto, con prioridades claras y pasos accionables — no un informe que junta polvo.",
    bullets: ["Relevamiento de procesos", "Plan de mejora", "Implementación guiada"],
    image: consultingImage,
    alt: "Consultoría digital en proceso",
  },
];
---

<section class="wrapper section-y">
  <div class="flex flex-col items-center gap-5 lg:gap-6">
    <h2
      data-text-reveal
      data-reveal
      class="mx-auto max-w-[600px] text-center font-display text-[32px] leading-[1.1] tracking-[-1px] sm:text-[44px] sm:tracking-[-1.4px] lg:max-w-[732px] lg:text-[66px] lg:tracking-[-1.98px]"
    >
      <span class="text-ink text-nowrap">Hacemos consultoría que </span><span class="font-bold text-teal">transforma equipos</span>
    </h2>
  </div>

  <div class="mt-12 flex flex-col gap-12 lg:mt-16 lg:flex-row lg:items-center lg:gap-[92px]">
    <div class="relative aspect-[771/592] w-full overflow-hidden lg:aspect-auto lg:h-[592px] lg:flex-1" data-reveal-scale>
      {
        items.map((item, i) => (
          <div class="absolute inset-0" data-service-image-item>
            <Image src={item.image} alt={item.alt} width={771} height={592} class="h-full w-full object-cover" />
          </div>
        ))
      }
      <canvas class="pointer-events-none absolute inset-0 z-10 h-full w-full" data-service-image-canvas aria-hidden="true"></canvas>
    </div>

    <div class="flex flex-col lg:w-[477px] lg:shrink-0">
      <div class="flex flex-col" data-accordion="teal" data-reveal>
        {
          items.map((item, i) => (
            <div data-accordion-item data-active={i === 0 ? "true" : "false"}>
              <div class="flex w-full items-center justify-between gap-4 py-4">
                <button type="button" class="flex-1 text-left" data-accordion-trigger>
                  <span
                    data-accordion-trigger-text
                    class:list={[
                      "font-body text-[24px] tracking-[-0.72px] sm:text-[32px] sm:tracking-[-0.96px]",
                      i === 0 ? "text-teal" : "text-ink",
                    ]}
                  >
                    {item.title}
                  </span>
                </button>
                <a
                  href={`/servicios/${item.slug}`}
                  aria-label={`Ver más sobre ${item.title}`}
                  class="relative h-[36px] w-[36px] shrink-0 transition-transform duration-300 ease-[var(--ease-default)] hover:-translate-y-0.5 hover:translate-x-0.5"
                >
                  <svg
                    data-accordion-icon-outline
                    viewBox="0 0 256 256"
                    fill="currentColor"
                    class:list={["absolute inset-0 h-full w-full text-secondary transition-opacity duration-300", i === 0 ? "opacity-0" : "opacity-100"]}
                  >
                    <path d="M168,96v48a8,8,0,0,1-16,0V115.31l-50.34,50.35a8,8,0,0,1-11.32-11.32L140.69,104H112a8,8,0,0,1,0-16h48A8,8,0,0,1,168,96Zm64,32A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z" />
                  </svg>
                  <svg
                    data-accordion-icon-fill
                    viewBox="0 0 256 256"
                    fill="currentColor"
                    class:list={["absolute inset-0 h-full w-full text-teal transition-opacity duration-300", i === 0 ? "opacity-100" : "opacity-0"]}
                  >
                    <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm40,120a8,8,0,0,1-16,0V115.31l-50.34,50.35a8,8,0,0,1-11.32-11.32L140.69,104H112a8,8,0,0,1,0-16h48a8,8,0,0,1,8,8Z" />
                  </svg>
                </a>
              </div>

              <div
                class:list={[
                  "grid overflow-hidden transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]",
                  i === 0 ? "grid-rows-[1fr]" : "grid-rows-[0fr]",
                ]}
                data-accordion-panel
              >
                <div class="flex min-h-0 flex-col gap-4">
                  <p
                    data-accordion-description
                    class="font-body text-[16px] leading-[1.5] tracking-[-0.3px] text-ink sm:text-[18px] sm:tracking-[-0.5px]"
                  >
                    {item.description}
                  </p>

                  <div class="flex flex-col gap-2">
                    {
                      item.bullets.map((bullet) => (
                        <div class="flex items-center gap-4">
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-teal">
                            <path d="M12 3l8 4v6c0 4.5-3.2 7.4-8 8.8C7.2 20.4 4 17.5 4 13V7l8-4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          <p class="font-body text-[16px] tracking-[-0.3px] text-ink sm:text-[18px] sm:tracking-[-0.5px]">{bullet}</p>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>

              <!--
                Esta línea separa un servicio del siguiente en reposo (gris,
                estática) y cuando el item se activa se convierte en la
                barra de progreso del auto-avance (se rellena de teal) — es
                el mismo elemento, no dos. El espacio antes de la línea vive
                acá (mt-5), no como padding dentro del panel colapsable —
                si fuera padding del panel, el padding se renderiza aunque
                el panel esté "cerrado" (grid-rows-[0fr] no le gana al
                padding-box) y deja asomar unos px del texto de arriba.
              -->
              <div class="mt-5 h-[2px] w-full overflow-hidden rounded-full bg-secondary/25" data-accordion-line>
                <div class="h-full w-0 rounded-full bg-teal" data-accordion-line-fill></div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
