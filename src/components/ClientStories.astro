---
/*
  Los logos son reales (24, en src/assets/img/client-logos/) pero las 24
  empresas y sus casos son ficticios — no hay clientes reales todavía (ver
  client-stories.js). El JS se encarga de rellenar cada casilla y
  rotarlas; acá solo armamos los 12 contenedores vacíos + los filtros.
*/
const rubros = ["Restaurantes", "Agencias de turismo", "Hotelera"];
const servicios = ["Digitalización", "Consultoría"];
---

<section class="wrapper section-y">
  <h2
    data-text-reveal
    data-reveal
    class="text-center font-display text-[32px] leading-[1.1] tracking-[-1px] sm:text-[44px] sm:tracking-[-1.4px] lg:text-[66px] lg:tracking-[-1.98px]"
  >
    Historias que <span class="text-navy">nos enorgullecen</span>
  </h2>

  <div class="relative z-30 mt-8 flex flex-wrap items-center justify-center gap-3 lg:mt-10" data-reveal>
    <button
      type="button"
      data-filter-reset
      class="bg-navy px-6 py-3 font-body text-[18px] tracking-[-0.5px] text-white"
    >
      Destacados
    </button>

    <div class="relative" data-dropdown>
      <button type="button" data-dropdown-trigger class="flex items-center gap-2 bg-[#e5e5e5] px-6 py-3 font-body text-[18px] tracking-[-0.5px] text-ink">
        <span data-dropdown-label="rubro" data-default-label="Ver por rubro">Ver por rubro</span>
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7.5l5 5 5-5" /></svg>
      </button>
      <div data-dropdown-panel class="absolute left-0 top-[calc(100%+8px)] z-20 hidden w-full min-w-[220px] overflow-hidden bg-white py-2 shadow-lg">
        {
          rubros.map((r) => (
            <button type="button" data-filter-option data-filter-type="rubro" data-filter-value={r} class="block w-full px-5 py-3 text-left font-body text-[16px] text-ink hover:bg-[#f5f5f6]">
              {r}
            </button>
          ))
        }
      </div>
    </div>

    <div class="relative" data-dropdown>
      <button type="button" data-dropdown-trigger class="flex items-center gap-2 bg-[#e5e5e5] px-6 py-3 font-body text-[18px] tracking-[-0.5px] text-ink">
        <span data-dropdown-label="servicio" data-default-label="Ver por servicio">Ver por servicio</span>
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7.5l5 5 5-5" /></svg>
      </button>
      <div data-dropdown-panel class="absolute left-0 top-[calc(100%+8px)] z-20 hidden w-full min-w-[220px] overflow-hidden bg-white py-2 shadow-lg">
        {
          servicios.map((s) => (
            <button type="button" data-filter-option data-filter-type="servicio" data-filter-value={s} class="block w-full px-5 py-3 text-left font-body text-[16px] text-ink hover:bg-[#f5f5f6]">
              {s}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div
    class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:mt-14 lg:grid-cols-4 lg:gap-[26px]"
    data-client-grid
    data-reveal
  >
    {
      Array.from({ length: 12 }).map((_, i) => (
        <div
          class="relative h-[120px] overflow-hidden bg-[#f5f5f6] transition-colors duration-300 sm:h-[150px] lg:h-[169px]"
          data-client-slot
          data-slot-index={i}
        >
          <div class="absolute inset-0" data-slot-logo-wrap>
            <img data-slot-logo class="h-full w-full object-cover" alt="" />
          </div>
          <div class="absolute inset-0 flex flex-col justify-center gap-3 p-5 opacity-0 sm:p-6" data-slot-desc>
            <p data-slot-desc-text class="font-body text-[14px] leading-[1.5] tracking-[0px] text-ink" />
            <span class="inline-flex items-center gap-1 font-body text-[14px] font-bold tracking-[0px] text-teal">
              Conoce la historia completa
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
            </span>
          </div>
        </div>
      ))
    }
  </div>
</section>
