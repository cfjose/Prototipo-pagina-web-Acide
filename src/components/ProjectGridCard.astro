---
import { Image } from "astro:assets";

interface Props {
  project: {
    client: string;
    title: string;
    tags: string[];
    description: string;
    image: ImageMetadata;
    alt: string;
    rubro: string;
    servicio: string;
  };
}

const { project } = Astro.props;
---

<div class="group flex flex-col items-start gap-6" data-reveal-fade data-pproject-card data-rubro={project.rubro} data-servicio={project.servicio}>
  <div class="relative aspect-square w-full overflow-hidden">
    <Image src={project.image} alt={project.alt} width={600} height={600} class="h-full w-full object-cover" />
  </div>
  <div class="flex flex-col items-start gap-2">
    <p class="font-body text-[26px] tracking-[-0.5px] text-secondary">{project.client}</p>
    <p class="font-body text-[32px] leading-[34px] font-medium tracking-[-0.96px] text-ink">{project.title}</p>
    <div class="flex items-center font-body text-[14px] text-secondary">
      {
        project.tags.map((tag, j) => (
          <span class:list={["py-1", j === 0 ? "pr-3" : "px-3", j > 0 && "border-l border-[#e1e0e0]"]}>{tag}</span>
        ))
      }
    </div>
    <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-[var(--ease-default)] group-hover:grid-rows-[1fr]">
      <div class="overflow-hidden">
        <p class="max-w-[560px] pt-2 font-body text-[18px] leading-[1.5] tracking-[-0.5px] text-ink">
          {project.description}
        </p>
      </div>
    </div>
  </div>
</div>
