---
import { Image } from "astro:assets";
import municipalidadImage from "../assets/img/certifications/municipalidad-arequipa.png";
import congresoImage from "../assets/img/certifications/congreso-republica.png";
import isoImage from "../assets/img/certifications/iso-9001.png";

/*
  "Certificaciones" — idéntico al patrón de "Así lo resolvimos"
  (CaseStudySolution.astro/case-study-solution.js): tarjetas apiladas
  que suben desde fuera de vista siempre en opacidad 100%, con borde
  blanco + sombra. Título fijo arriba, sin cruzar con el texto.

  Contenido real (mismo texto que los hitos de "Nuestra historia",
  AboutHistory.astro, solo recortado a lo específico de cada
  reconocimiento) con los 3 escudos/logos reales que mandó el cliente.
  A diferencia del resto de fotos del sitio, estos son logos con fondo
  blanco (no fotografías) — por eso la tarjeta usa fondo blanco +
  object-contain en vez de object-cover, para que el escudo se vea
  completo y sin recortar.

  Atributos con prefijo "about-cert-" para no chocar con el mismo
  patrón que ya usa CaseStudySolution (data-solution-*) en la otra página.
*/
const certifications = [
  {
    title: "Municipalidad de Arequipa",
    description:
      "Reconocimiento a la Innovación y Excelencia Emprendedora (2024) — la Municipalidad Provincial de Arequipa distinguió a ACIDE por su impacto y contribución al desarrollo económico y social de la región.",
    image: municipalidadImage,
    alt: "Escudo de la Municipalidad Provincial de Arequipa",
  },
  {
    title: "Congreso de la República",
    description:
      "Reconocimiento por Trayectoria y Desarrollo Sostenible (2023) — el Congreso de la República del Perú distinguió a ACIDE por su contribución al desarrollo sostenible del país y su práctica empresarial ética y responsable.",
    image: congresoImage,
    alt: "Logo del Congreso de la República del Perú",
  },
  {
    title: "ISO 9001",
    description:
      "Certificación de calidad obtenida en 2016, que reconoce nuestra gestión en atención al cliente, proyectos, asesoría y capacitación en sectores públicos y privados.",
    image: isoImage,
    alt: "Logo de la certificación ISO 9001",
  },
];
---

<!-- Desktop: fondo azul, viewport completo, título fijo, sección fija (pin) -->
<section class="hidden lg:flex lg:h-screen lg:flex-col lg:items-center lg:justify-center lg:bg-[#0B2238]" data-about-cert-pin>
  <div class="wrapper flex w-full flex-col items-center gap-[84px]">
    <h2 data-text-reveal data-reveal class="text-center font-display text-[66px] leading-none tracking-[-1.98px] text-white">Certificaciones</h2>

    <div class="flex w-full items-center gap-[111px]">
      <div class="flex w-[529px] shrink-0 flex-col items-start gap-9">
        <div class="grid w-full" data-about-cert-text-stack>
          {
            certifications.map((cert, i) => (
              <div class="col-start-1 row-start-1 flex flex-col items-start gap-9 text-left" data-about-cert-text-item data-index={i}>
                <h3 class="font-body text-[54px] leading-none font-medium tracking-[-1.62px] text-white" data-about-cert-title>
                  {cert.title}
                </h3>
                <p class="font-body text-[26px] leading-[1.5] tracking-[-0.5px] text-white/90" data-about-cert-description>
                  {cert.description}
                </p>
              </div>
            ))
          }
        </div>
        <svg class="size-9 text-white/70" viewBox="0 0 256 256" fill="currentColor">
          <path d="M205.66,149.66l-72,72a8,8,0,0,1-11.32,0l-72-72a8,8,0,0,1,11.32-11.32L120,196.69V40a8,8,0,0,1,16,0V196.69l58.34-58.35a8,8,0,0,1,11.32,11.32Z" />
        </svg>
      </div>

      <div class="relative h-[700px] w-full flex-1" data-about-cert-media-stack>
        <!--
          Alto del recorte = pantalla completa (h-screen), no h-full de
          este contenedor de 700px — mismo ajuste que en
          CaseStudySolution.astro/ServiceProcess.astro: si el recorte
          midiera lo mismo que la caja visible, los logos "aparecen"
          desde el borde de esa caja (que por el título de arriba no
          llega hasta abajo de la sección) en vez de desde abajo de la
          sección entera. top-1/2 -translate-y-1/2 mantiene el centro
          del recorte en el mismo punto de siempre para que las
          tarjetas no se muevan de lugar en reposo.
        -->
        <div class="absolute top-1/2 left-1/2 h-screen w-[145%] -translate-x-1/2 -translate-y-1/2 overflow-hidden">
          {
            certifications.map((cert, i) => (
              <div
                class="absolute top-1/2 left-1/2 h-[494px] w-[672px] -mt-[247px] -ml-[336px] border-[10px] border-white bg-white p-16 shadow-2xl shadow-black/40"
                data-about-cert-media-item
                data-index={i}
              >
                <Image src={cert.image} alt={cert.alt} width={672} height={494} class="h-full w-full object-contain" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobile/tablet: lista vertical simple, sin pin -->
<section class="wrapper section-y bg-[#0B2238] lg:hidden">
  <h2 data-text-reveal data-reveal class="mb-10 text-center font-display text-[32px] leading-[1.1] tracking-[-1px] text-white sm:text-[44px] sm:tracking-[-1.4px]">
    Certificaciones
  </h2>
  <div class="flex flex-col gap-8">
    {
      certifications.map((cert) => (
        <div class="flex flex-col overflow-hidden border border-white/10" data-reveal>
          <div class="aspect-[672/494] w-full overflow-hidden bg-white p-10">
            <Image src={cert.image} alt={cert.alt} width={672} height={494} class="h-full w-full object-contain" />
          </div>
          <div class="flex flex-col gap-3 p-6">
            <h3 class="font-body text-[22px] font-medium tracking-[-0.66px] text-white">{cert.title}</h3>
            <p class="font-body text-[16px] leading-[1.5] tracking-[-0.3px] text-white/80">{cert.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
