---
import { Image } from "astro:assets";
import teamImage from "../assets/img/digital-today/team.png";
import appImage from "../assets/img/hero/phone-app.png";
import marketingImage from "../assets/img/hero/desk-palette.png";
import auditImage from "../assets/img/hero/server-room.png";

/*
  Las descripciones y sub-servicios de "Aplicaciones Web", "Marketing
  Digital" y "Auditoría Digital" son copy modelo — en Figma solo está
  escrita la de "Sitios Web" (el item que aparece expandido por default).
  Reemplazar por el copy real del cliente cuando esté.

  Las imágenes de Aplicaciones Web / Marketing Digital / Auditoría Digital
  reutilizan fotos del hero (no hay herramienta de generación de imágenes
  disponible) — encajan temáticamente pero se repiten en la página.

  Los links "Ver mas información del servicio" apuntan a /servicios/<slug>
  — esas páginas todavía no existen, van a dar 404 hasta que se armen.
*/
const services = [
  {
    title: "Sitios Web",
    slug: "sitios-web",
    description:
      "Más de una década transformando ideas en productos digitales que no solo funcionan — generan resultados medibles para empresas de toda la región.",
    bullets: ["Diseño UX/UI", "Desarrollo web", "Despliegue del sitio"],
    image: teamImage,
    alt: "Equipo trabajando frente a pantallas con código y dashboards",
  },
  {
    title: "Aplicaciones Web",
    slug: "aplicaciones-web",
    description:
      "Diseñamos y desarrollamos aplicaciones a medida que resuelven problemas reales, desde el primer sketch hasta el deploy en producción, con foco en performance y experiencia de uso.",
    bullets: ["Arquitectura de producto", "Desarrollo a medida", "Soporte y mantenimiento"],
    image: appImage,
    alt: "Celular en un soporte mostrando un dashboard de métricas",
  },
  {
    title: "Marketing Digital",
    slug: "marketing-digital",
    description:
      "Estrategias de adquisición y contenido que conectan con las personas correctas en el momento correcto — medimos cada resultado para que la inversión se traduzca en crecimiento real.",
    bullets: ["Estrategia de contenido", "Pauta y performance", "Analítica y reportes"],
    image: marketingImage,
    alt: "Laptop con paleta de colores y notas de diseño",
  },
  {
    title: "Auditoría Digital",
    slug: "auditoria-digital",
    description:
      "Revisamos a fondo tu stack, tu seguridad y tu performance para que sepas exactamente dónde estás parado y qué resolver antes de que se vuelva un problema.",
    bullets: ["Diagnóstico técnico", "Análisis de seguridad", "Plan de acción"],
    image: auditImage,
    alt: "Pasillo de un centro de datos",
  },
];
---

<section class="wrapper section-y lg:pt-[200px]">
  <div class="flex flex-col gap-5 lg:gap-6">
    <h2
      data-text-reveal
      data-reveal
      class="max-w-[600px] font-display text-[32px] font-bold leading-[1.1] tracking-[-1px] sm:text-[44px] sm:tracking-[-1.4px] lg:max-w-[732px] lg:text-[66px] lg:tracking-[-1.98px]"
    >
      <span class="text-secondary">Desarrollamos, </span><span class="text-navy">código con propósito</span>
    </h2>
    <div class="lg:flex lg:justify-end">
      <p
        data-text-reveal
        data-reveal
        class="font-body text-[16px] leading-[1.5] tracking-[-0.3px] text-ink sm:text-[18px] sm:tracking-[-0.5px] lg:max-w-[600px] lg:text-[26px] lg:tracking-[-0.5px]"
      >
        TechGroup tenía un problema que nadie quería resolver: un sistema interno que frenaba a sus equipos. Lo
        reinventamos desde cero. El resultado fue una plataforma que redujo tiempos operativos un 40% y devolvió la
        agilidad que habían perdido.
      </p>
    </div>
  </div>

  <div class="mt-12 flex flex-col gap-12 lg:mt-16 lg:flex-row lg:items-center lg:gap-[92px]">
    <div class="flex flex-col lg:w-[477px] lg:shrink-0">
      <div class="flex flex-col" data-accordion="navy" data-reveal>
        {
          services.map((service, i) => (
            <div data-accordion-item data-active={i === 0 ? "true" : "false"}>
              <button type="button" class="flex w-full items-center justify-between gap-4 py-4 text-left" data-accordion-trigger>
                <span
                  data-accordion-trigger-text
                  class:list={[
                    "font-body text-[24px] tracking-[-0.72px] sm:text-[32px] sm:tracking-[-0.96px]",
                    i === 0 ? "text-navy" : "text-ink",
                  ]}
                >
                  {service.title}
                </span>
                <span class="relative h-[24px] w-[24px] shrink-0" data-accordion-icon>
                  <span class="absolute left-1/2 top-1/2 h-[2px] w-[14px] -translate-x-1/2 -translate-y-1/2 bg-current" />
                  <span
                    class:list={[
                      "absolute left-1/2 top-1/2 h-[14px] w-[2px] -translate-x-1/2 -translate-y-1/2 bg-current transition-transform duration-300 ease-[var(--ease-default)]",
                      i === 0 ? "scale-y-0" : "scale-y-100",
                    ]}
                    data-accordion-icon-vertical
                  />
                </span>
              </button>

              <div
                class:list={[
                  "grid overflow-hidden transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]",
                  i === 0 ? "grid-rows-[1fr]" : "grid-rows-[0fr]",
                ]}
                data-accordion-panel
              >
                <div class="flex min-h-0 flex-col gap-4 pb-6">
                  <p
                    data-accordion-description
                    class="font-body text-[16px] leading-[1.5] tracking-[-0.3px] text-ink sm:text-[18px] sm:tracking-[-0.5px]"
                  >
                    {service.description}
                  </p>

                  <div class="flex flex-col gap-2">
                    {
                      service.bullets.map((bullet) => (
                        <div class="flex items-center gap-4">
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="shrink-0 text-teal">
                            <path d="M12 3l8 4v6c0 4.5-3.2 7.4-8 8.8C7.2 20.4 4 17.5 4 13V7l8-4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          <p class="font-body text-[16px] tracking-[-0.3px] text-ink sm:text-[18px] sm:tracking-[-0.5px]">{bullet}</p>
                        </div>
                      ))
                    }
                  </div>

                  <a
                    href={`/servicios/${service.slug}`}
                    class="group flex items-center justify-between gap-4 pt-1"
                  >
                    <span class="font-body text-[16px] font-bold tracking-[-0.3px] text-navy sm:text-[18px] sm:tracking-[-0.5px]">
                      Ver mas información del servicio
                    </span>
                    <span class="flex h-[28px] w-[28px] shrink-0 items-center justify-center rounded-full bg-navy text-white transition-transform duration-300 ease-[var(--ease-default)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5 sm:h-[32px] sm:w-[32px]">
                      <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                        <path d="M6 14L14 6M14 6H7M14 6v7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!--
        Una sola barra de progreso compartida por todo el acordeón (no una
        por item) — el JS la reubica dentro del item activo cada vez que
        cambia, así nunca hay más de una visible al mismo tiempo.
      -->
      <div class="mt-1 h-[3px] w-full overflow-hidden rounded-full bg-black/10" data-accordion-progress>
        <div class="h-full w-0 rounded-full bg-navy" data-accordion-progress-fill></div>
      </div>
    </div>

    <div class="relative aspect-[771/568] w-full overflow-hidden rounded-[12px] lg:aspect-auto lg:h-[568px] lg:flex-1" data-reveal-scale>
      {
        services.map((service, i) => (
          <div class="absolute inset-0" data-service-image-item>
            <Image src={service.image} alt={service.alt} width={771} height={568} class="h-full w-full object-cover" />
          </div>
        ))
      }
    </div>
  </div>
</section>
