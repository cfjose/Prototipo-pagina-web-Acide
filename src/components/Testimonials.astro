---
import quotesIcon from "../assets/img/testimonials/quotes-vector.svg";

/*
  Videos en Google Drive (archivos demasiado pesados para Git LFS en
  local). Se embebe la vista previa: un <video src="drive..."> no
  reproduce bien archivos de +100 MB (Drive interpone el aviso de
  virus). Compartir como "cualquiera con el enlace".
*/
const drivePreview = (url) => {
  const id = url.match(/\/d\/([^/]+)/)?.[1] ?? url.match(/[?&]id=([^&]+)/)?.[1];
  return id ? `https://drive.google.com/file/d/${id}/preview` : url;
};

const testimonials = [
  {
    quote:
      "Llegamos a Acide con una idea a medio armar y nos devolvieron un producto que superó lo que imaginábamos. Desde el día uno entendieron lo que necesitábamos y nos acompañaron sin soltar el timón. Profesionales de verdad.",
    name: "Alejandra Martínez",
    role: "Gerente en TechGroup",
    video: drivePreview("https://drive.google.com/file/d/1cpz4TVK6tbXKmxxpRr0mXn7d1VYw0-xj/view?usp=sharing"),
  },
  {
    quote:
      "Necesitábamos una app que no se sintiera como una app corporativa más. Acide entendió el producto casi mejor que nosotros y lo tradujo en algo que nuestros usuarios realmente disfrutan usar.",
    name: "Rodrigo Fernández",
    role: "CEO en Aurora",
    video: drivePreview("https://drive.google.com/file/d/1nWU5_1x1PFSItCiA5Ubhp9YKq1g9LFHt/view?usp=sharing"),
  },
  {
    quote:
      "El equipo de Acide se metió de lleno en nuestra estrategia de marketing digital — no vinieron con una fórmula genérica, armaron algo a medida y los resultados se notaron en el primer trimestre.",
    name: "Camila Torres",
    role: "Directora de Marketing en Cloudox",
    video: drivePreview("https://drive.google.com/file/d/1sT5ISTln4oFxKNmzbkNzhUB54fSHE1y7/view?usp=sharing"),
  },
  {
    quote:
      "La auditoría que nos hicieron encontró problemas que ni sabíamos que teníamos. Con ese diagnóstico pudimos priorizar en serio, en vez de seguir apagando incendios.",
    name: "Martín Silva",
    role: "Fundador de Nexus",
    video: drivePreview("https://drive.google.com/file/d/1ufV3B4CwKicexigqMsytejrFpMLfqPe6/view?usp=sharing"),
  },
];
---

<section class="wrapper section-y">
  <div class="bg-[#f5f5f6] px-6 py-12 sm:px-10 lg:p-16" data-testimonial-pin>
    <h2 data-text-reveal data-reveal class="text-center font-display text-[32px] leading-[1.1] tracking-[-1px] sm:text-[44px] sm:tracking-[-1.4px] lg:text-[66px] lg:tracking-[-1.98px]">
      Ya confiaron <span class="text-navy">en nosotros</span>
    </h2>

    <div class="mt-12 flex flex-col gap-10 lg:mt-16 lg:flex-row lg:items-center lg:gap-16">
      <div class="relative aspect-[527/297] w-full overflow-hidden rounded-[12px] lg:flex-1" data-reveal-scale data-testimonial-video-group>
        {
          testimonials.map((t, i) => (
            <div
              class="absolute inset-0"
              data-testimonial-image
              data-testimonial-video-wrapper
              style={i === 0 ? "opacity: 1; z-index: 2;" : "opacity: 0; z-index: 1; pointer-events: none;"}
            >
              <iframe
                data-testimonial-video
                data-src={t.video}
                src={i === 0 ? t.video : undefined}
                title={`Testimonio en video de ${t.name}`}
                allow="autoplay"
                allowfullscreen
                class="absolute left-0 top-[-12%] h-[124%] w-full border-0"
              />
            </div>
          ))
        }

      </div>

      <div class="flex flex-col items-start gap-6 lg:w-[500px] lg:shrink-0">
        <img src={quotesIcon.src} width="55" height="40" alt="" aria-hidden="true" class="w-[40px] rotate-180 sm:w-[55px]" />

        <div class="grid w-full">
          {
            testimonials.map((t, i) => (
              <p
                data-testimonial-quote
                class="[grid-area:1/1] font-body text-[20px] leading-[1.5] tracking-[-0.4px] text-ink sm:text-[26px] sm:tracking-[-0.5px]"
                style={i === 0 ? "opacity: 1;" : "opacity: 0;"}
              >
                {t.quote}
              </p>
            ))
          }
        </div>

        <div class="grid w-full border-t border-secondary/40 pt-3">
          {
            testimonials.map((t, i) => (
              <div data-testimonial-author class="[grid-area:1/1] flex flex-col font-body" style={i === 0 ? "opacity: 1;" : "opacity: 0;"}>
                <p class="text-[18px] tracking-[-0.5px] text-ink">{t.name}</p>
                <p class="text-[14px] text-secondary">{t.role}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-12 flex items-center gap-3 lg:mt-16" data-testimonial-bars>
      {
        testimonials.map((t, i) => (
          <button
            type="button"
            data-testimonial-bar
            aria-label={`Ver testimonio de ${t.name}`}
            class="h-[4px] flex-1 overflow-hidden rounded-full bg-[#6a8d92]"
          >
            <div
              data-testimonial-bar-fill
              class="h-full w-0 rounded-full bg-[#f43159]"
            />
          </button>
        ))
      }
    </div>
  </div>
</section>
