---
import logo from "../assets/img/logo.svg";

const navLinks = [
  { label: "Servicios", href: "/servicios" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Sobre nosotros", href: "/sobre-nosotros" },
  { label: "Blog", href: "/blog" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);

/*
  Un solo header sticky (flujo normal, se queda arriba al scrollear).
  Fondo de vidrio translúcido. Tipografía más chica que el 18px de Figma.
  Un único subrayado que viaja entre ítems (header-scroll.js).
  CTA con relleno tipo pintura (.btn-paint).
*/
---

<header
  data-header
  class="sticky top-0 z-50 bg-canvas/75 backdrop-blur-md backdrop-saturate-150"
>
  <div class="wrapper flex items-center justify-between py-3">
    <a
      href="/"
      class="inline-flex shrink-0 items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2"
    >
      <img src={logo.src} width={logo.width} height={logo.height} alt="Acide" class="h-[24px] w-auto lg:h-[28px]" />
    </a>

    <nav
      data-header-nav
      class="relative hidden items-center gap-10 font-body text-[15px] tracking-[-0.3px] text-ink xl:flex"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link"
            data-nav-link
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <span data-nav-underline aria-hidden="true" class="nav-underline"></span>
    </nav>

    <a
      href="#contacto"
      class="btn-paint hidden min-h-10 items-center justify-center px-5 xl:inline-flex"
    >
      <span>Contáctanos</span>
    </a>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="-mr-2 flex size-10 cursor-pointer items-center justify-center text-ink transition-colors duration-200 hover:text-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 aria-expanded:text-navy xl:hidden"
    >
      <span class="sr-only">Abrir menú</span>
      <svg data-menu-icon-open width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
      <svg data-menu-icon-close class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-nav"
    data-mobile-nav
    class="grid grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-300 ease-[var(--ease-default)] xl:hidden"
  >
    <div class="min-h-0">
      <nav class="wrapper flex flex-col pb-5 font-body text-[15px] tracking-[-0.3px] text-ink">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="flex min-h-11 items-center border-b border-ink/[0.08] py-3.5 transition-colors duration-200 hover:text-navy focus-visible:text-navy focus-visible:outline-none active:text-navy aria-[current=page]:text-navy"
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
        <a href="#contacto" class="btn-paint mt-4 flex min-h-11 items-center justify-center px-5 py-3">
          <span>Contáctanos</span>
        </a>
      </nav>
    </div>
  </div>
</header>
