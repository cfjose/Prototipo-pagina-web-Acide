---
import logo from "../assets/img/logo.svg";

const navLinks = [
  { label: "Servicios", href: "/servicios" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Sobre nosotros", href: "#nosotros" },
  { label: "Blog", href: "#blog" },
];

/*
  Dos estados (Figma: Header Default / Variant2), solo en desktop
  (xl+, donde vive el nav completo — en mobile/tablet el header se
  queda estático como siempre, ver header-scroll.js):

  - "default": el header de siempre — transparente, pegado arriba,
    texto gris. Es el que se ve mientras estás dentro del hero (la
    primera sección) de cualquier página.
  - "floating": una vez que scrolleás más allá del hero, el header
    pasa a fixed y dentro se ve la misma barra de 1312px que el
    default, pero con fondo navy sólido + sombra, más padding
    (px-36/py-24 en vez de px-5/8 y py-6), texto y logo blancos. Ahí
    además se oculta al scrollear hacia abajo y reaparece flotando a
    28px del borde superior al scrollear hacia arriba.

  El fondo/sombra y el padding van en la barra interna (data-header-bar),
  no en el <header> — el <header> solo fija posición/ancho completo
  para poder centrar la barra adentro con mx-auto. El toggle de clases
  de la barra lo hace header-scroll.js con classList, porque son
  demasiadas clases en conflicto (wrapper+padding chico vs.
  padding grande+fondo) para resolver solo con variantes data-[...] de
  Tailwind.

  El header es xl:fixed siempre (para que el cambio entre estados no
  mueva contenido) — por eso <main> tiene un padding-top que lo
  compensa, ver BaseLayout.astro.
*/
---

<header
  data-header
  data-header-mode="default"
  data-header-hidden="false"
  class="group/header relative z-50 bg-canvas xl:fixed xl:inset-x-0 xl:top-0 xl:transition-all xl:duration-500 xl:ease-[var(--ease-default)] xl:data-[header-mode=floating]:top-[28px] xl:data-[header-mode=floating]:bg-transparent xl:data-[header-hidden=true]:-translate-y-[200px]"
>
  <div class="wrapper flex items-center justify-between py-6" data-header-bar>
    <a href="/" class="shrink-0">
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt="Acide"
        class="h-[28px] w-auto transition-[filter] duration-500 ease-[var(--ease-default)] group-data-[header-mode=floating]/header:xl:brightness-0 group-data-[header-mode=floating]/header:xl:invert lg:h-[34px]"
      />
    </a>

    <nav class="hidden items-center gap-8 font-body text-[18px] tracking-[-0.5px] text-secondary group-data-[header-mode=floating]/header:xl:text-white xl:flex xl:gap-[94px]">
      {
        navLinks.map((link) => (
          <a href={link.href} class="nav-link hover:text-ink group-data-[header-mode=floating]/header:xl:hover:text-white/70">
            {link.label}
          </a>
        ))
      }
    </nav>

    <a href="#contacto" class="btn btn--primary hidden py-2 xl:inline-flex">Contáctanos</a>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="-mr-2 flex items-center justify-center p-2 xl:hidden"
    >
      <span class="sr-only">Abrir menú</span>
      <svg data-menu-icon-open width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
      <svg data-menu-icon-close class="hidden" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-nav"
    data-mobile-nav
    class="grid grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] xl:hidden"
  >
    <div class="min-h-0">
      <nav class="wrapper flex flex-col gap-1 pb-6 font-body text-[18px] text-secondary">
        {
          navLinks.map((link) => (
            <a href={link.href} class="border-b border-black/5 py-4">
              {link.label}
            </a>
          ))
        }
        <a href="#contacto" class="btn btn--primary mt-4 w-full">Contáctanos</a>
      </nav>
    </div>
  </div>
</header>
