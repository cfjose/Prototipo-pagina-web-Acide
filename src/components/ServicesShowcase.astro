---
import { Image } from "astro:assets";
import tile00 from "../assets/img/idea-showcase/tile-00.png";
import tile02 from "../assets/img/idea-showcase/tile-02.png";
import tile03 from "../assets/img/idea-showcase/tile-03.png";
import tile04 from "../assets/img/idea-showcase/tile-04.png";
import tile05 from "../assets/img/idea-showcase/tile-05.png";
import tile06 from "../assets/img/idea-showcase/tile-06.png";
import tile07 from "../assets/img/idea-showcase/tile-07.png";
import tile08 from "../assets/img/idea-showcase/tile-08.png";
import tile09 from "../assets/img/idea-showcase/tile-09.png";
import tile10 from "../assets/img/idea-showcase/tile-10.png";
import tile11 from "../assets/img/idea-showcase/tile-11.png";
import tile12 from "../assets/img/idea-showcase/tile-12.png";

/*
  Rediseño 1:1 del Figma (node 178:1250): 6 columnas de 5 celdas, con
  solo 13 de las 30 celdas ocupadas por foto — el resto quedan en
  blanco a propósito, dando el patrón tipo tablero de ajedrez que se ve
  en el diseño (cada columna alterna foto/vacío, y las columnas
  vecinas empiezan en fase contraria). `null` = celda vacía.

  La fila del medio (índice 2) va vacía en las 6 columnas, sin
  excepción — en el Figma original la columna 0 sí tenía foto ahí,
  pero como esa columna quedaba lejos del título (centrado) nunca se
  cruzaban. Acá el grid entero se desplaza en loop, así que esa foto
  tarde o temprano pasaría justo detrás del título; para que eso no
  choque nunca, se sacrifica esa foto (tile01, sin usar) y la fila del
  medio queda limpia en todo el ancho.

  En desktop, todo el grid se duplica una vez al lado del otro dentro
  de [data-showcase-track] y se traslada en loop infinito hacia la
  derecha (ver services-showcase.js) — el truco estándar de "marquee":
  como la copia 2 es idéntica a la 1, al completar un ciclo de
  transformX el corte es invisible. [data-showcase-viewport] recorta
  con overflow-hidden para que solo se vea un ancho de grid a la vez.

  El hover que apaga el resto del collage mientras resalta la tarjeta
  bajo el mouse es el mismo patrón que ya usábamos acá antes (y en
  historias de clientes) — se mantiene igual, solo que ahora corre
  sobre fotos estáticas en vez del Ken Burns anterior (el movimiento
  ya lo da el propio scroll del carrusel).
*/
const columns: (ImageMetadata | null)[][] = [
  [tile00, null, null, null, tile02],
  [null, tile03, null, tile04, null],
  [tile05, null, null, null, tile06],
  [null, tile07, null, tile08, null],
  [tile09, null, null, null, tile10],
  [null, tile11, null, tile12, null],
];

const alt = "Persona usando una app en el celular";
const flatTiles = columns.flat().filter((tile): tile is ImageMetadata => tile !== null);
---

<section class="wrapper section-y xl:pt-5">
  <!--
    A diferencia del resto de la sección (título, grid mobile), el
    carrusel de escritorio se pide a todo el ancho de la página, no
    encajonado en el wrapper de 1312px — mismo truco de "breakout" que
    ResultsCarousel.astro (left-1/2 + w-screen + -translate-x-1/2),
    solo a partir de lg (en mobile/tablet sigue adentro del wrapper,
    como el resto del sitio).

    El alto YA NO se deriva de aspect-[1444/1001] (eso hacía que en
    pantallas anchas y bajas el alto real superara por mucho el
    viewport, obligando a scrollear DENTRO de la sección) — ahora es
    lg:h-screen directo: el cuadro completo (ancho Y alto) mide
    como mucho una pantalla, sin importar la proporción del monitor.
  -->
  <div class="relative mx-auto w-full lg:left-1/2 lg:h-screen lg:w-screen lg:-translate-x-1/2" data-showcase>
    <!--
      lg:bg-canvas + lg:p-[54px]: colchón de 54px pedido entre el texto
      y las imágenes que lo rodean — el ancho sube de 772 a 880 (772 +
      54*2) para que el ÁREA DE TEXTO siga siendo 772px como en el
      Figma, el padding se suma afuera de eso, no lo achica. El fondo
      blanco es más red de seguridad que necesidad real (la fila del
      medio del grid ya viene vacía en las 6 columnas), por si el alto
      real de esa fila terminara siendo menor al que hace falta acá.

      data-type-heading: el mismo efecto de tipeo/caret que usan los
      h1/h2 en navy o teal (ver text-type.js) — como este es un <p>, no
      un h1/h2, no lo agarra el selector normal; esta marca lo suma a
      esa lista sin ensanchar el selector a CUALQUIER <p> del sitio.
      text-reveal.js ya sabe saltarse los elementos con esta marca para
      no animarlo dos veces (ver isTypewriterHeading).
    -->
    <p
      data-text-reveal
      data-reveal
      data-type-heading
      class="static mb-10 text-center font-display text-[32px] leading-[1.05] tracking-[-0.03em] sm:text-[44px] lg:absolute lg:inset-x-0 lg:top-[38.06%] lg:z-20 lg:mx-auto lg:mb-0 lg:w-[880px] lg:bg-canvas lg:p-[54px] lg:text-[78px]"
    >
      <span class="text-ink">De una idea a un gran </span><span class="text-navy">producto digital</span>
    </p>

    <!-- Desktop: carrusel infinito de 2 copias del mismo grid -->
    <div class="hidden lg:absolute lg:inset-0 lg:block lg:overflow-hidden" data-showcase-viewport>
      <!--
        Mismo criterio que el degradado del Hero (home): como el
        carrusel corta en seco a los costados, un degradado angosto a
        blanco en cada borde disimula el corte — acá es horizontal
        (izq/der) porque el movimiento es horizontal, a diferencia del
        Hero que es vertical.
      -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-[8%] bg-gradient-to-r from-white to-white/0"></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-[8%] bg-gradient-to-l from-white to-white/0"></div>
      <div class="flex h-full" data-showcase-track>
        {
          [0, 1].map((copyIndex) => (
            <div class:list={["grid h-full shrink-0 grid-cols-6 gap-3", copyIndex === 1 && "ml-3"]} data-showcase-copy aria-hidden={copyIndex === 1}>
              {
                columns.map((col) => (
                  <div class="flex h-full flex-col gap-3">
                    {
                      col.map((tile, ri) =>
                        tile ? (
                          <div class="relative flex-1 overflow-hidden" data-showcase-tile>
                            <Image
                              src={tile}
                              alt={copyIndex === 0 ? alt : ""}
                              width={230}
                              height={191}
                              class="h-full w-full object-cover"
                              data-showcase-media
                            />
                          </div>
                        ) : ri === 2 ? (
                          // Alto fijo (no flex-1) — lo calcula measureLayout()
                          // en services-showcase.js a partir del alto REAL del
                          // texto (que no cambia con el ancho: es tamaño de
                          // fuente fijo en px), para garantizar que esta fila
                          // siempre sea al menos tan alta como el texto+padding
                          // y las filas vecinas de fotos nunca queden tapadas
                          // ni recortadas por él.
                          <div class="shrink-0" data-showcase-gap-row />
                        ) : (
                          <div class="flex-1" />
                        )
                      )
                    }
                  </div>
                ))
              }
            </div>
          ))
        }
      </div>
    </div>

    <!-- Mobile/tablet: grid estático, sin carrusel ni hover (no hay mouse real) -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:hidden">
      {
        flatTiles.map((tile) => (
          <div class="relative aspect-square overflow-hidden">
            <Image src={tile} alt={alt} width={330} height={330} class="h-full w-full object-cover" />
          </div>
        ))
      }
    </div>
  </div>
</section>
