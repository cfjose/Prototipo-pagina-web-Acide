---
import { Image } from "astro:assets";
import tile00 from "../assets/img/idea-showcase/tile-00.png";
import tile02 from "../assets/img/idea-showcase/tile-02.png";
import tile03 from "../assets/img/idea-showcase/tile-03.png";
import tile04 from "../assets/img/idea-showcase/tile-04.png";
import tile05 from "../assets/img/idea-showcase/tile-05.png";
import tile06 from "../assets/img/idea-showcase/tile-06.png";
import tile07 from "../assets/img/idea-showcase/tile-07.png";
import tile08 from "../assets/img/idea-showcase/tile-08.png";
import tile09 from "../assets/img/idea-showcase/tile-09.png";
import tile10 from "../assets/img/idea-showcase/tile-10.png";
import tile11 from "../assets/img/idea-showcase/tile-11.png";
import tile12 from "../assets/img/idea-showcase/tile-12.png";

/*
  Rediseño 1:1 del Figma (node 178:1250), con una diferencia a pedido:
  las 2 filas de arriba se mueven hacia la derecha y las 2 de abajo
  hacia la izquierda (antes todo el grid se movía junto, una sola
  dirección). Como dentro de UN mismo track las filas comparten
  siempre la misma posición X, no hay forma de que dos filas se muevan
  en sentidos distintos si viven en el mismo elemento — por eso son
  DOS tracks independientes (arriba/abajo), cada uno con su propio
  loop infinito (ver services-showcase.js).

  Ojo con esto: en un intento anterior separamos arriba/abajo pero
  reemplazamos la fila vacía del medio (que reservaba espacio real
  para el título) por una caja de posición fija superpuesta con CSS —
  eso rompió el calce y dejaba fotos asomando por los bordes del
  título. Acá se vuelve al mecanismo que sí funcionaba: una fila
  vacía real entre ambos tracks (data-showcase-gap-row) cuyo alto Y la
  posición del título se recalculan por JS a partir del alto real del
  texto (ver applyGapHeight en services-showcase.js) — mismo criterio
  que en la versión de un solo grid, solo que ahora el "espaciador" es
  un elemento aparte en vez de una fila compartida por las 6 columnas.

  Checkerboard: mismo patrón de ajedrez que el diseño original (cada
  columna alterna foto/vacío, columnas vecinas en fase contraria),
  separado en top (filas 0-1 del grid original) y bottom (filas 3-4) —
  la fila 2 (el hueco del medio) es justamente la que ahora es el
  espaciador de arriba. `null` = celda vacía.
*/
const topColumns: (ImageMetadata | null)[][] = [
  [tile00, null],
  [null, tile03],
  [tile05, null],
  [null, tile07],
  [tile09, null],
  [null, tile11],
];
const bottomColumns: (ImageMetadata | null)[][] = [
  [null, tile02],
  [tile04, null],
  [null, tile06],
  [tile08, null],
  [null, tile10],
  [tile12, null],
];

const alt = "Persona usando una app en el celular";
const flatTiles = [...topColumns, ...bottomColumns].flat().filter((tile): tile is ImageMetadata => tile !== null);
---

<section class="wrapper section-y xl:pt-5">
  <!--
    A diferencia del resto de la sección (título, grid mobile), el
    carrusel de escritorio se pide a todo el ancho de la página, no
    encajonado en el wrapper de 1312px — mismo truco de "breakout" que
    ResultsCarousel.astro (left-1/2 + w-screen + -translate-x-1/2),
    solo a partir de lg (en mobile/tablet sigue adentro del wrapper,
    como el resto del sitio).

    El alto YA NO se deriva de aspect-[1444/1001] (eso hacía que en
    pantallas anchas y bajas el alto real superara por mucho el
    viewport, obligando a scrollear DENTRO de la sección) — ahora es
    lg:h-screen directo: el cuadro completo (ancho Y alto) mide
    como mucho una pantalla, sin importar la proporción del monitor.
  -->
  <div class="relative mx-auto w-full lg:left-1/2 lg:h-screen lg:w-screen lg:-translate-x-1/2" data-showcase>
    <!--
      lg:bg-canvas + lg:p-[54px]: colchón de 54px pedido entre el texto
      y las imágenes que lo rodean — el ancho sube de 772 a 880 (772 +
      54*2) para que el ÁREA DE TEXTO siga siendo 772px como en el
      Figma, el padding se suma afuera de eso, no lo achica.

      lg:top-[38%] es solo el fallback antes de que corra el JS —
      services-showcase.js pisa este top con un valor en px calculado
      contra data-showcase-gap-row (ver applyGapHeight), igual que en
      la versión de un solo grid.

      data-type-heading: el mismo efecto de tipeo/caret que usan los
      h1/h2 en navy o teal (ver text-type.js) — como este es un <p>, no
      un h1/h2, no lo agarra el selector normal; esta marca lo suma a
      esa lista sin ensanchar el selector a CUALQUIER <p> del sitio.
      text-reveal.js ya sabe saltarse los elementos con esta marca para
      no animarlo dos veces (ver isTypewriterHeading).
    -->
    <p
      data-text-reveal
      data-reveal
      data-type-heading
      class="static mb-10 text-center font-display text-[32px] leading-[1.05] tracking-[-0.03em] sm:text-[44px] lg:absolute lg:inset-x-0 lg:top-[38%] lg:z-20 lg:mx-auto lg:mb-0 lg:w-[880px] lg:bg-canvas lg:p-[54px] lg:text-[78px]"
      data-showcase-title
    >
      <span class="text-ink">De una idea a un gran </span><span class="text-navy">producto digital</span>
    </p>

    <!--
      Desktop: dos pistas apiladas (arriba se mueve a la derecha, abajo
      a la izquierda), con una fila vacía real entre ambas que reserva
      el espacio del título (data-showcase-gap-row, alto puesto por
      JS) — mismo mecanismo que la versión de un solo grid, ver arriba.
    -->
    <div class="hidden lg:absolute lg:inset-0 lg:flex lg:flex-col lg:overflow-hidden">
      <!--
        Degradado en los costados para disimular el corte del
        carrusel — spannea las DOS pistas (arriba y abajo juntas),
        mismo criterio que el degradado vertical del Hero.
      -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-[8%] bg-gradient-to-r from-white to-white/0"></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-[8%] bg-gradient-to-l from-white to-white/0"></div>

      <div class="relative flex-1 overflow-hidden" data-showcase-viewport-top>
        <div class="flex h-full" data-showcase-track-top>
          {
            [0, 1].map((copyIndex) => (
              <div class:list={["grid h-full shrink-0 grid-cols-6 gap-3", copyIndex === 1 && "ml-3"]} data-showcase-copy-top aria-hidden={copyIndex === 1}>
                {
                  topColumns.map((col) => (
                    <div class="flex h-full flex-col gap-3">
                      {
                        col.map((tile) =>
                          tile ? (
                            <div class="relative flex-1 overflow-hidden" data-showcase-tile>
                              <Image
                                src={tile}
                                alt={copyIndex === 0 ? alt : ""}
                                width={230}
                                height={191}
                                class="h-full w-full object-cover"
                                data-showcase-media
                              />
                            </div>
                          ) : (
                            <div class="flex-1" />
                          )
                        )
                      }
                    </div>
                  ))
                }
              </div>
            ))
          }
        </div>
      </div>

      <!-- Alto fijo (no flex-1) — lo calcula applyGapHeight() en services-showcase.js a partir del alto real del texto -->
      <div class="shrink-0" data-showcase-gap-row></div>

      <div class="relative flex-1 overflow-hidden" data-showcase-viewport-bottom>
        <div class="flex h-full" data-showcase-track-bottom>
          {
            [0, 1].map((copyIndex) => (
              <div class:list={["grid h-full shrink-0 grid-cols-6 gap-3", copyIndex === 1 && "ml-3"]} data-showcase-copy-bottom aria-hidden={copyIndex === 1}>
                {
                  bottomColumns.map((col) => (
                    <div class="flex h-full flex-col gap-3">
                      {
                        col.map((tile) =>
                          tile ? (
                            <div class="relative flex-1 overflow-hidden" data-showcase-tile>
                              <Image
                                src={tile}
                                alt={copyIndex === 0 ? alt : ""}
                                width={230}
                                height={191}
                                class="h-full w-full object-cover"
                                data-showcase-media
                              />
                            </div>
                          ) : (
                            <div class="flex-1" />
                          )
                        )
                      }
                    </div>
                  ))
                }
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Mobile/tablet: grid estático, sin carrusel ni hover (no hay mouse real) -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:hidden">
      {
        flatTiles.map((tile) => (
          <div class="relative aspect-square overflow-hidden">
            <Image src={tile} alt={alt} width={330} height={330} class="h-full w-full object-cover" />
          </div>
        ))
      }
    </div>
  </div>
</section>
