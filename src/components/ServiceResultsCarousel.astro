---
import { Image } from "astro:assets";
import cardLeftImage from "../assets/img/sitios-web/results-card-left.png";
import centerImage from "../assets/img/sitios-web/results-center.png";
import cardRightImage from "../assets/img/sitios-web/results-card-right.png";

/*
  "Resultados que hablan por sí solos" para esta página — mismo
  mecanismo que ResultsCarousel.astro de /servicios (pin + zoom entre 3
  proyectos, cursor "Ver proyecto"), pero con los tamaños EXACTOS que
  trae el Figma de esta página en particular, que son distintos a los
  genéricos: centro 996x553 (no 1184x664), costados 683x384 (igual),
  gap 24px (igual). Ver service-results-carousel.js.

  Solo TechGroup tiene nombre real en el Figma — Cloudox y Aurora son
  nombres y etiquetas de servicio ficticios (mismos clientes ya
  inventados en Testimonios/ResultsCarousel, no son datos nuevos).
*/
const projects = [
  {
    image: cardLeftImage,
    alt: "Monitor mostrando un dashboard de logística de Cloudox",
    name: "Cloudox",
    tags: ["Arquitectura de producto", "Desarrollo a medida", "Soporte y mantenimiento"],
  },
  {
    image: centerImage,
    alt: "Estación de trabajo con dos monitores mostrando el dashboard de TechGroup",
    name: "TechGroup",
    tags: ["Diseño UX/UI", "Desarrollo", "Despliegue"],
  },
  {
    image: cardRightImage,
    alt: "Celular mostrando la app financiera de Aurora",
    name: "Aurora",
    tags: ["Diagnóstico técnico", "Análisis de seguridad", "Plan de acción"],
  },
];
---

<section class="section-y overflow-hidden">
  <!-- Mobile/tablet: título en flujo normal -->
  <div class="wrapper lg:hidden">
    <h2
      data-text-reveal
      data-reveal
      class="text-center font-display text-[32px] leading-[1.1] tracking-[-1px] text-ink sm:text-[44px] sm:tracking-[-1.4px]"
    >
      Resultados que <span class="font-bold text-navy">hablan por sí solos</span>
    </h2>
  </div>

  <!-- Desktop: stage fijo con zoom + cursor a medida (título adentro, ver ResultsCarousel.astro) -->
  <div class="relative mt-16 hidden lg:block" data-sresults-pin>
    <div class="wrapper">
      <h2
        data-text-reveal
        data-reveal
        class="text-center font-display text-[66px] leading-[1.1] tracking-[-1.98px] text-ink"
      >
        Resultados que <span class="font-bold text-navy">hablan por sí solos</span>
      </h2>
    </div>

    <div class="relative left-1/2 mt-16 w-screen -translate-x-1/2" data-sresults-stage>
      {
        projects.map((project, i) => (
          <a
            href="#contacto"
            aria-label={`Ver proyecto de ${project.name}`}
            class="absolute top-1/2 overflow-hidden"
            data-sresults-card
            data-index={i}
          >
            <Image src={project.image} alt={project.alt} width={996} height={553} class="h-full w-full object-cover" />
            <span class="pointer-events-none absolute inset-0 bg-black/0 transition-colors duration-300" data-sresults-overlay />
          </a>
        ))
      }
    </div>

    <div class="relative mt-10 grid justify-items-center">
      {
        projects.map((project, i) => (
          <div class="col-start-1 row-start-1 flex flex-col items-center gap-1 opacity-0" data-sresults-caption data-index={i}>
            <p class="font-body text-[32px] font-medium tracking-[-0.96px] text-ink">{project.name}</p>
            <div class="flex items-center font-body text-[18px] text-ink">
              {project.tags.map((tag, j) => (
                <span class:list={["px-3 py-1", j > 0 && "border-l border-[#e1e0e0]"]}>{tag}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Mobile/tablet: franja horizontal con scroll-snap, sin pin ni cursor -->
  <div class="mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 lg:hidden">
    {
      projects.map((project) => (
        <div class="flex w-[85%] shrink-0 snap-center flex-col items-center gap-4 sm:w-[60%]">
          <div class="aspect-[996/553] w-full overflow-hidden">
            <Image src={project.image} alt={project.alt} width={996} height={553} class="h-full w-full object-cover" />
          </div>
          <div class="flex flex-col items-center gap-1">
            <p class="font-body text-[24px] font-medium tracking-[-0.96px] text-ink">{project.name}</p>
            <div class="flex items-center font-body text-[18px] text-ink">
              {project.tags.map((tag, j) => (
                <span class:list={["px-3 py-1", j > 0 && "border-l border-[#e1e0e0]"]}>{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Cursor a medida: mismo patrón que ResultsCarousel.astro -->
  <div
    class="pointer-events-none fixed top-0 left-0 z-50 hidden -translate-x-1/2 -translate-y-1/2 scale-75 items-center gap-3 font-body text-[26px] tracking-[-0.5px] text-white opacity-0 lg:flex"
    data-sresults-cursor
    aria-hidden="true"
  >
    <span>Ver proyecto</span>
    <svg width="28" height="28" viewBox="0 0 256 256" fill="currentColor">
      <path d="M168,96v48a8,8,0,0,1-16,0V115.31l-50.34,50.35a8,8,0,0,1-11.32-11.32L140.69,104H112a8,8,0,0,1,0-16h48A8,8,0,0,1,168,96Zm64,32A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z" />
    </svg>
  </div>
</section>
