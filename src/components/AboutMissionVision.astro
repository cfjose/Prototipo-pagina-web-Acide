---
import { Image } from "astro:assets";
import missionImage from "../assets/img/mission-vision/mision.png";
import visionImage from "../assets/img/mission-vision/vision.png";

/*
  "Nuestra misión" / "Nuestra visión" — mismo patrón que "El resultado
  que logramos" del caso de estudio (case-study-results.js): sección
  fija (pin), texto a la izquierda + imagen a la derecha, el scroll
  cruza entre los 2 estados con la misma "cinta continua" (el texto
  que sale sigue subiendo/bajando mientras se desvanece, el que entra
  viene del lado contrario), imagen con cross-fade + zoom, barra de
  progreso de 2 segmentos abajo.

  El Figma solo trae el copy de "Nuestra misión" (título+descripción+
  imagen) — no hay un estado de "visión" en el archivo. El texto de
  visión de acá es inventado, mismo tono que el resto del copy
  modelo del sitio.

  Atributos con prefijo "about-" para no chocar con los otros gallery-
  pin de la página (mismo motivo de siempre — ver about-mission-vision.js).
*/
const items = [
  {
    title: "Nuestra misión",
    description:
      "Impulsar el crecimiento de empresas y entidades públicas mediante soluciones digitales de alta calidad. Nos comprometemos a entregar software confiable, consultoría estratégica y acompañamiento continuo en cada etapa del proyecto.",
    image: missionImage,
    alt: "Equipo de Acide colaborando frente a laptops en una reunión",
  },
  {
    title: "Nuestra visión",
    description:
      "Ser reconocidos como el socio digital de referencia en la región — la primera opción cuando una empresa necesita convertir una idea ambiciosa en un producto real. Crecemos junto a nuestros clientes, no a costa de ellos.",
    image: visionImage,
    alt: "Persona mirando hacia adelante desde su escritorio",
  },
];
---

<section class="wrapper section-y">
  <!-- Desktop: stage fijo, misión y visión se cruzan en el mismo lugar -->
  <div class="relative hidden lg:block" data-about-mv-pin>
    <div data-about-mv-pin-content>
      <div class="grid w-full grid-cols-2 items-center gap-[111px]">
        <div class="grid" data-about-mv-text-stack>
          {
            items.map((item, i) => (
              <div class="col-start-1 row-start-1 flex flex-col justify-center gap-6" data-about-mv-text-item data-index={i}>
                <h2 class="font-display text-[66px] leading-none tracking-[-1.98px]">
                  <span class="text-navy">Nuestra</span> <span class="text-teal">{item.title.replace("Nuestra ", "")}</span>
                </h2>
                <p class="max-w-[533px] font-body text-[26px] leading-[1.5] tracking-[-0.5px] text-ink">{item.description}</p>
              </div>
            ))
          }
        </div>

        <div class="relative mx-auto aspect-[533/685] h-auto w-full max-w-full overflow-hidden" data-about-mv-media-stack>
          {
            items.map((item) => (
              <div class="absolute inset-0" data-about-mv-media-item>
                <Image src={item.image} alt={item.alt} width={533} height={685} class="h-full w-full object-cover" />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-[60px] flex items-center gap-3" data-about-mv-bars>
      {
        items.map(() => (
          <div class="h-[3px] flex-1 overflow-hidden bg-black/10">
            <div class="h-full w-0 bg-navy" data-about-mv-bar-fill />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Mobile/tablet: lista normal, sin pin -->
  <div class="flex flex-col gap-16 lg:hidden">
    {
      items.map((item) => (
        <div class="flex flex-col gap-6">
          <div class="relative aspect-[533/685] w-full overflow-hidden">
            <Image src={item.image} alt={item.alt} width={533} height={685} class="h-full w-full object-cover" />
          </div>
          <h2 class="font-display text-[38px] leading-[1.05] tracking-[-1.2px] sm:text-[44px]">
            <span class="text-navy">Nuestra</span> <span class="text-teal">{item.title.replace("Nuestra ", "")}</span>
          </h2>
          <p class="font-body text-[18px] leading-[1.5] tracking-[-0.5px] text-ink">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>
