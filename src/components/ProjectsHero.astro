---
import { Image } from "astro:assets";
import heroImage from "../assets/img/proyectos/hero.png";

/*
  Cabecera de /proyectos. H1 en su posición normal (como el resto de
  los heroes del sitio, sin efecto de pantalla completa) y la imagen
  inmediatamente 54px debajo (margin-top real, no un padding de otra
  sección) — ambos visibles juntos desde que carga la página, sin
  ninguna animación de entrada.

  La imagen arranca en 912px de ancho (69.51% del wrapper de 1312px)
  y crece a su ancho completo (1312px / 100%) a medida que el usuario
  la scrollea — scroll normal, sin fijar la pantalla. Alto fijo en
  829px (nunca anima, ver projects-hero.js).

  Nota: esta sección NO usa la clase ".wrapper" para el ancho de la
  imagen porque esa clase suma padding horizontal (px-8) por dentro
  del max-w-[1312px], y eso le restaría los últimos px al 100% —
  achicándolo a 1248px en vez de los 1312px reales del Figma.
*/
---

<section class="mx-auto flex w-full max-w-[1312px] flex-col items-center px-5 py-16 sm:px-8 lg:px-0 lg:pt-[100px] lg:pb-[80px] xl:pt-5">
  <h1
    data-text-reveal
    data-reveal
    class="max-w-[941px] text-center font-display text-[38px] leading-[1.05] tracking-[-1.2px] sm:text-[52px] sm:tracking-[-2px] lg:text-[78px] lg:tracking-[-3.12px]"
  >
    <span class="text-slate">Proyectos que hablan </span><span class="text-navy">por nuestro trabajo</span>
  </h1>

  <div class="mt-[54px] w-[69.51%]" data-projects-hero-image>
    <div class="aspect-[1312/829] w-full overflow-hidden lg:aspect-auto lg:h-[829px]">
      <Image src={heroImage} alt="Collage de proyectos desarrollados por Acide" width={1312} height={829} class="h-full w-full object-cover" />
    </div>
  </div>
</section>
