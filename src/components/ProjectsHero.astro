---
import { Image } from "astro:assets";
import heroImage from "../assets/img/proyectos/hero.png";

/*
  Cabecera de /proyectos — el Figma acá solo trae título, sin
  descripción corta (a diferencia de otras páginas), así que no
  inventamos una — se confirmó explícitamente dejarlo así.

  La imagen debajo arranca al 75% de su ancho (1/4 más angosta) y
  llega a su ancho completo (el mismo de todas las secciones, el
  wrapper) a medida que el usuario la scrollea — no es un reveal de
  aparecer/desaparecer, es un crecimiento de ancho atado al scroll
  (scrub), ver projects-hero.js.
*/
---

<section class="wrapper section-y flex flex-col items-center gap-14">
  <h1
    data-text-reveal
    data-reveal
    class="max-w-[941px] text-center font-display text-[38px] leading-[1.05] tracking-[-1.2px] sm:text-[52px] sm:tracking-[-2px] lg:text-[78px] lg:tracking-[-3.12px]"
  >
    <span class="text-slate">Proyectos que hablan </span><span class="text-navy">por nuestro trabajo</span>
  </h1>

  <div class="mx-auto w-[75%]" data-projects-hero-image>
    <div class="aspect-[1312/616] w-full overflow-hidden">
      <Image src={heroImage} alt="Collage de proyectos desarrollados por Acide" width={1312} height={616} class="h-full w-full object-cover" />
    </div>
  </div>
</section>
