---
/*
  "Socios estratégicos" — misma idea que "Historias que nos
  enorgullecen" (ClientStories.astro/client-stories.js): grilla de 12
  casillas con una marca abstracta generada por JS (no hay logos
  reales de estos socios ni herramienta de generación de imágenes) que
  van rotando solas, y al pasar el mouse la casilla se queda quieta y
  muestra una historia de esa alianza. A diferencia de Historias, acá
  el Figma NO trae filtros — grid + hover nada más, sin dropdowns.

  Atributos con prefijo "about-partner-" para no chocar con
  data-client-* (client-stories.js corre en todas las páginas vía
  main.js) — ver about-partners.js.
*/
---

<section class="wrapper section-y">
  <h2 class="text-center font-display text-[32px] leading-[1.1] tracking-[-1px] sm:text-[44px] sm:tracking-[-1.4px] lg:text-[66px] lg:tracking-[-1.98px]">
    <span class="text-navy">Socios</span> <span class="text-teal">estratégicos</span>
  </h2>

  <div
    class="mt-14 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:mt-[76px] lg:grid-cols-4 lg:gap-[26px]"
    data-about-partner-grid
    data-reveal
  >
    {
      Array.from({ length: 12 }).map((_, i) => (
        <div
          class="relative h-[120px] overflow-hidden bg-[#f5f5f6] transition-colors duration-300 sm:h-[150px] lg:h-[169px]"
          data-about-partner-slot
          data-slot-index={i}
        >
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 px-4" data-slot-logo-wrap>
            <span data-slot-icon class="h-[36px] w-[36px] sm:h-[44px] sm:w-[44px]" />
            <span data-slot-logo class="text-center font-body text-[14px] font-bold uppercase tracking-[0px] text-ink" />
          </div>
          <div class="absolute inset-0 flex flex-col justify-center gap-3 p-5 opacity-0 sm:p-6" data-slot-desc>
            <p data-slot-desc-text class="font-body text-[14px] leading-[1.5] tracking-[0px] text-ink" />
            <span class="inline-flex items-center gap-1 font-body text-[14px] font-bold tracking-[0px] text-teal">
              Conoce la historia completa
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
            </span>
          </div>
        </div>
      ))
    }
  </div>
</section>
