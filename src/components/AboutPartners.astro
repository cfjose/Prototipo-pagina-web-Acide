---
import camaraPymeLogo from "../assets/img/partners-logos/camara-pyme.png";
import camaraComercioLogo from "../assets/img/partners-logos/camara-comercio.png";
import gobiernoRegionalLogo from "../assets/img/partners-logos/gobierno-regional.png";
import laSalleLogo from "../assets/img/partners-logos/la-salle.png";
import sanMartinLogo from "../assets/img/partners-logos/san-martin-de-porres.png";
import upeUnionLogo from "../assets/img/partners-logos/universidad-peruana-union.png";

/*
  "Socios estratégicos" — 6 logos reales (src/assets/img/partners-logos/),
  grilla estática de 2 filas x 3 (no hay rotación: con exactamente 6
  socios y 6 casillas no hace falta el mini-pool rotativo que sí usa
  "Historias que nos enorgullecen", que tiene 24 empresas para 12
  casillas). Mismo hover que Historias: la casilla se queda quieta,
  fondo gris, aparece la descripción — el resto de la grilla baja a 15%
  de opacidad (ver about-partners.js).

  Las descripciones son copy modelo (no tenemos el texto real de cada
  alianza, solo los logos) — La Salle y San Martín de Porres sí son
  alianzas reales mencionadas en "Nuestra historia" (2018), las otras 4
  se redactaron con el mismo criterio institucional. Reemplazar por el
  texto real cuando esté.

  Atributos con prefijo "about-partner-" para no chocar con
  data-client-* (client-stories.js corre en todas las páginas vía
  main.js) — ver about-partners.js.
*/
const partners = [
  { name: "Cámara PYME", logo: camaraPymeLogo, description: "Aliados en el desarrollo de la pequeña y mediana empresa — trabajamos juntos en programas de digitalización para negocios en crecimiento." },
  { name: "Cámara de Comercio", logo: camaraComercioLogo, description: "Colaboramos con la Cámara de Comercio en iniciativas de transformación digital para el tejido empresarial de la región." },
  { name: "Gobierno Regional", logo: gobiernoRegionalLogo, description: "Trabajamos con el Gobierno Regional en proyectos de digitalización de servicios públicos y gestión de datos." },
  { name: "La Salle", logo: laSalleLogo, description: "Alianza estratégica con la Universidad La Salle desde 2018, formando profesionales en gestión pública y tecnología." },
  { name: "San Martín de Porres", logo: sanMartinLogo, description: "Alianza estratégica con la Universidad San Martín de Porres desde 2018, en programas de capacitación técnica." },
  { name: "Universidad Peruana Unión", logo: upeUnionLogo, description: "Colaboramos con la Universidad Peruana Unión en programas de formación técnica y desarrollo profesional." },
];
---

<section class="wrapper section-y">
  <h2 class="text-center font-display text-[32px] leading-[1.1] tracking-[-1px] sm:text-[44px] sm:tracking-[-1.4px] lg:text-[66px] lg:tracking-[-1.98px]">
    <span class="text-navy">Socios</span> <span class="text-teal">estratégicos</span>
  </h2>

  <div
    class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-6 lg:mt-[76px] lg:gap-10"
    data-about-partner-grid
    data-reveal
  >
    {
      partners.map((partner, i) => (
        <div
          class="relative h-[120px] overflow-hidden bg-[#f5f5f6] transition-colors duration-300 sm:h-[150px] lg:h-[169px]"
          data-about-partner-slot
          data-slot-index={i}
          data-partner-name={partner.name}
        >
          <div class="absolute inset-0" data-slot-logo-wrap>
            <img src={partner.logo.src} alt={`Logo de ${partner.name}`} class="h-full w-full object-cover" />
          </div>
          <div class="absolute inset-0 flex flex-col justify-center gap-3 p-5 opacity-0 sm:p-6" data-slot-desc>
            <p class="font-body text-[14px] leading-[1.5] tracking-[0px] text-ink">{partner.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
